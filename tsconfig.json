{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `steward` is excluded because it is a separate project, not part of this
  // Next.js app: it has its own package.json, its own build (`eve build`) and
  // its own type check, which `eve info` reports as Diagnostics. It also uses
  // eve's authoring conventions — notably explicit `.ts` import specifiers —
  // which this config rejects (TS5097). Type errors there are caught by
  // `npm --prefix steward run check`, not by this tsconfig.
  "exclude": ["node_modules", "_archive", "docs", "steward"]
}

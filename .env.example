# Shared secret for the Experiences scheduler. A recurring job (Coolify scheduled task
# or pg_cron) POSTs /api/admin/experiences/send-due with this value in the
# `x-cron-secret` header (or Authorization: Bearer) to release due program emails.
EXPERIENCE_CRON_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=jw@michaeljgauthier.com
SMTP_PASSWORD=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=jw@michaeljgauthier.com
IMAP_PASSWORD=
POP3_HOST=pop.hostinger.com
POP3_PORT=995
POP3_SECURE=true

# ============================================================
# 💳 STRIPE — Steward commerce (TEST MODE)
# Dashboard: dashboard.stripe.com/test/apikeys
# Paste the TEST keys below. Anything starting sk_live_ / pk_live_ here
# would take real money from real cards while we are still reviewing copy.
# ============================================================

# Secret key — the only one strictly required. Hosted Stripe Checkout is a
# server-side redirect, so the publishable key is not needed unless we embed
# checkout in our own page. Starts sk_test_
STRIPE_SECRET_KEY=

# Webhook signing secret. This is what makes an order real: without it we would
# be trusting the browser's return URL to claim "paid", which is how you end up
# granting free subscriptions. Starts whsec_
#   local:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
#   hosted: dashboard.stripe.com/test/webhooks -> add endpoint -> signing secret
STRIPE_WEBHOOK_SECRET=

# Publishable key — ONLY needed for embedded checkout or Stripe.js. Leave blank
# for the hosted redirect flow. Starts pk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Guard rail read by the commerce code: refuse to run against live keys unless
# this is explicitly set to "live". Leave as "test".
STRIPE_MODE=test
